{
  "name": "@edgetts/server",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@edgetts/edge-provider": "workspace:*",
    "@edgetts/shared": "workspace:*",
    "@edgetts/tts-core": "workspace:*",
    "@edgetts/tts-service": "workspace:*",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11",
    "zod-to-json-schema": "^3.25.2"
  }
}
