{
  "name": "edgetts-monorepo",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n \"server,web\" \"pnpm --filter @edgetts/server dev\" \"pnpm --filter @edgetts/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test && pnpm test:architecture && pnpm test:docs && pnpm test:release",
    "test:architecture": "node --test tests/architecture-boundaries.test.mjs",
    "test:docs": "node --test tests/docs-consistency.test.mjs",
    "test:release": "bash tests/release-guard.test.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
