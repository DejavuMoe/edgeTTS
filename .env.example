# Required by default for Docker Compose production deployments.
# Generate with: openssl rand -hex 32
# API_KEY=replace-with-a-random-secret

# Production Compose defaults to true (fail-closed if API_KEY is unset).
# Set to false only when a trusted external layer provides authentication.
# REQUIRE_API_KEY=true

# Host binding configuration for Docker Compose.
# Defaults to loopback (127.0.0.1) for reverse-proxy security.
EDGETTS_BIND_ADDRESS=127.0.0.1
EDGETTS_HOST_PORT=8080

# Speech synthesis admission rate limits (per server process)
# SPEECH_RATE_LIMIT_MAX=12
# SPEECH_RATE_LIMIT_WINDOW_MS=10000
